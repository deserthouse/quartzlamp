<?xml version="1.0" encoding="utf-8"?>
<!-- 正式图标（W4）：石英晶体切面 × 声波——三面拉开对比 + 中面微渐变 + 声波加粗 4.5dp（T9 建议） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 石英晶体切面（安全区内） -->
    <!-- 左上受光亮面 -->
    <path
        android:fillColor="#8F93F7"
        android:pathData="M54,26 L54,54 L34,46 Z" />
    <!-- 右上中面（微渐变） -->
    <path android:pathData="M54,26 L74,46 L54,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="26"
                android:endX="74"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#6A6DF0" />
                <item android:offset="1.0" android:color="#4A4CC9" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 下部暗面 -->
    <path
        android:fillColor="#33349E"
        android:pathData="M34,46 L54,54 L46,82 L41,82 Z" />
    <path
        android:fillColor="#3E40B5"
        android:pathData="M54,54 L74,46 L67,82 L46,82 Z" />
    <!-- 高光棱线 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="1.6"
        android:fillColor="#00000000"
        android:pathData="M54,26 L54,54" />
    <!-- 声波纹（加粗 4.5，亮紫白） -->
    <path
        android:strokeColor="#E2E1FF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M47,58 Q50.5,54.5 54,58 Q57.5,61.5 61,58" />
    <path
        android:strokeColor="#E2E1FF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M43,66 Q50.5,58.5 54,66 Q57.5,73.5 65,66" />
    <path
        android:strokeColor="#BFC3FF"
        android:strokeAlpha="0.85"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M39,74 Q50.5,62.5 54,74 Q57.5,85.5 69,74" />
</vector>
